<?xml version="1.0" encoding="utf-8"?>
<!-- Keys are ATAK preferences, so a .pref file (or a mission package with one) sets the same
     values. Plugin preference categories can't have members, hence the flat list. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/takconvo_pref_cat_account" />

    <com.atakmap.android.gui.PanCheckBoxPreference
        android:defaultValue="true"
        android:key="takconvo_xmpp_enabled"
        android:summary="@string/takconvo_pref_enabled_summary"
        android:title="@string/takconvo_pref_enabled" />

    <com.atakmap.android.gui.PanCheckBoxPreference
        android:defaultValue="true"
        android:key="takconvo_xmpp_use_tak_credentials"
        android:summary="@string/takconvo_pref_use_tak_summary"
        android:title="@string/takconvo_pref_use_tak" />

    <com.atakmap.android.gui.PanPreference
        android:key="takconvo_account"
        android:title="@string/takconvo_pref_account" />

    <com.atakmap.android.gui.PanCheckBoxPreference
        android:defaultValue="true"
        android:key="takconvo_xmpp_use_callsign"
        android:summary="@string/takconvo_pref_use_callsign_summary"
        android:title="@string/takconvo_pref_use_callsign" />

    <PreferenceCategory android:title="@string/takconvo_pref_cat_notifications" />

    <com.atakmap.android.gui.PanCheckBoxPreference
        android:defaultValue="true"
        android:key="takconvo_notification_sound"
        android:summary="@string/takconvo_pref_notification_sound_summary"
        android:title="@string/takconvo_pref_notification_sound" />

    <com.atakmap.android.gui.PanCheckBoxPreference
        android:defaultValue="true"
        android:key="takconvo_notification_vibrate"
        android:summary="@string/takconvo_pref_notification_vibrate_summary"
        android:title="@string/takconvo_pref_notification_vibrate" />

    <PreferenceCategory android:title="@string/takconvo_pref_cat_server" />

    <com.atakmap.android.gui.PanEditTextPreference
        android:dialogTitle="@string/takconvo_pref_domain"
        android:inputType="textUri|textNoSuggestions"
        android:key="takconvo_xmpp_domain"
        android:singleLine="true"
        android:title="@string/takconvo_pref_domain" />

    <com.atakmap.android.gui.PanEditTextPreference
        android:dialogTitle="@string/takconvo_pref_host"
        android:inputType="textUri|textNoSuggestions"
        android:key="takconvo_xmpp_host"
        android:singleLine="true"
        android:title="@string/takconvo_pref_host" />

    <com.atakmap.android.gui.PanEditTextPreference
        android:defaultValue="5222"
        android:dialogTitle="@string/takconvo_pref_port"
        android:inputType="number"
        android:key="takconvo_xmpp_port"
        android:singleLine="true"
        android:title="@string/takconvo_pref_port" />

    <com.atakmap.android.gui.PanListPreference
        android:defaultValue="xmpp_server"
        android:dialogTitle="@string/takconvo_pref_channel_discovery"
        android:entries="@array/takconvo_channel_discovery_entries"
        android:entryValues="@array/takconvo_channel_discovery_values"
        android:key="takconvo_xmpp_channel_discovery"
        android:title="@string/takconvo_pref_channel_discovery" />

    <com.atakmap.android.gui.PanEditTextPreference
        android:dialogTitle="@string/takconvo_pref_channel_server"
        android:inputType="textUri|textNoSuggestions"
        android:key="takconvo_xmpp_channel_server"
        android:singleLine="true"
        android:title="@string/takconvo_pref_channel_server" />

    <PreferenceCategory android:title="@string/takconvo_pref_cat_trust" />

    <com.atakmap.android.gui.PanCheckBoxPreference
        android:defaultValue="true"
        android:key="takconvo_xmpp_use_tak_truststore"
        android:summary="@string/takconvo_pref_use_tak_truststore_summary"
        android:title="@string/takconvo_pref_use_tak_truststore" />

    <com.atakmap.android.gui.PanCheckBoxPreference
        android:defaultValue="false"
        android:key="takconvo_xmpp_use_android_ca_store"
        android:summary="@string/takconvo_pref_use_android_ca_store_summary"
        android:title="@string/takconvo_pref_use_android_ca_store" />

    <com.atakmap.android.gui.PanPreference
        android:key="takconvo_trusted_ca_picker"
        android:title="@string/takconvo_pref_trusted_ca" />

    <PreferenceCategory android:title="@string/takconvo_pref_cat_provisioning" />

    <com.atakmap.android.gui.PanPreference
        android:key="takconvo_import_pref"
        android:summary="@string/takconvo_pref_import_summary"
        android:title="@string/takconvo_pref_import" />
</PreferenceScreen>
