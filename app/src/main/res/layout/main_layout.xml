<?xml version="1.0" encoding="utf-8"?>
<!-- Spike UI: engine status and a plain send box. Replaced by the Conversations UI later. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="false"
    android:layout_marginLeft="3dp"
    android:layout_marginRight="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/takconvo_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="13sp" />

        <Button
            android:id="@+id/takconvo_reconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/takconvo_reconnect" />

        <EditText
            android:id="@+id/takconvo_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/takconvo_to_hint"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <EditText
            android:id="@+id/takconvo_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/takconvo_body_hint"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/takconvo_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/takconvo_send" />

        <TextView
            android:id="@+id/takconvo_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
